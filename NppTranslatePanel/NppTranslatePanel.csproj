  <PropertyGroup>
    <!-- Default values for debugging so it starts the correct version of Notepad++
         $(ProgramW6432) and $(MSBuildProgramFiles32) point to the 64 and 32 bit "Program Files" directories -->
    <NppPath64 Condition="'$(NppPath64)' == ''">$(ProgramW6432)\Notepad++</NppPath64>
    <NppPath32 Condition="'$(NppPath32)' == ''">$(MSBuildProgramFiles32)\Notepad++</NppPath32>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(Platform)'=='x64'">$(NppPath64)\notepad++.exe</StartProgram>
    <StartProgram Condition="'$(Platform)'=='x86'">$(NppPath32)\notepad++.exe</StartProgram>
    <!-- Where the build copies the DLL to. Notepad++ only scans <install dir>\plugins, NOT
         %APPDATA%\Notepad++\plugins (that folder is config-only), so this defaults to the real
         plugins folder, which requires an elevated build. Override to a staging directory
         (e.g. /p:NppPluginsDir64=C:\stage /p:NppPluginsDir32=C:\stage) to build unelevated and
         copy the DLL into place by hand afterwards. -->
    <NppPluginsDir64 Condition="'$(NppPluginsDir64)' == ''">$(NppPath64)\plugins</NppPluginsDir64>
    <NppPluginsDir32 Condition="'$(NppPluginsDir32)' == ''">$(NppPath32)\plugins</NppPluginsDir32>
  </PropertyGroup>
  <PropertyGroup>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
